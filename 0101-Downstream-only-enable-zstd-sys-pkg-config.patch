From 081c1edba4a4fd95d9af900892e087aa8185a3d9 Mon Sep 17 00:00:00 2001
From: Rodolfo Olivieri <rolivier@redhat.com>
Date: Mon, 28 Sep 2026 11:10:00 -0300
Subject: [PATCH] Downstream only: enable zstd-sys pkg-config

---
 vendor/zstd-0.14.0/Cargo.toml               | 1 +
 vendor/zstd-safe-8.0.0/Cargo.toml           | 1 +
 vendor/zstd-sys-2.1.0+zstd.1.5.7/Cargo.toml | 1 +
 3 files changed, 3 insertions(+)

diff --git a/vendor/zstd-0.14.0/Cargo.toml b/vendor/zstd-0.14.0/Cargo.toml
index e12edcd..00103c3 100644
--- a/vendor/zstd-0.14.0/Cargo.toml
+++ b/vendor/zstd-0.14.0/Cargo.toml
@@ -58,6 +58,7 @@ cmake = ["zstd-safe/cmake"]
 debug = ["zstd-safe/debug"]
 default = [
     "legacy",
+    "pkg-config",
     "arrays",
     "zdict_builder",
 ]
diff --git a/vendor/zstd-safe-8.0.0/Cargo.toml b/vendor/zstd-safe-8.0.0/Cargo.toml
index 201ca95..2a1a178 100644
--- a/vendor/zstd-safe-8.0.0/Cargo.toml
+++ b/vendor/zstd-safe-8.0.0/Cargo.toml
@@ -52,6 +52,7 @@ cmake = ["zstd-sys/cmake"]
 debug = ["zstd-sys/debug"]
 default = [
     "legacy",
+    "pkg-config",
     "arrays",
     "zdict_builder",
 ]
diff --git a/vendor/zstd-sys-2.1.0+zstd.1.5.7/Cargo.toml b/vendor/zstd-sys-2.1.0+zstd.1.5.7/Cargo.toml
index fe65b8a..792c832 100644
--- a/vendor/zstd-sys-2.1.0+zstd.1.5.7/Cargo.toml
+++ b/vendor/zstd-sys-2.1.0+zstd.1.5.7/Cargo.toml
@@ -65,6 +65,7 @@ cmake = ["dep:cmake"]
 debug = []
 default = [
     "legacy",
+    "pkg-config",
     "zdict_builder",
 ]
 experimental = []
-- 
2.55.0

